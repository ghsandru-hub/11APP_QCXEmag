# Block all direct HTTP access to this folder.
# The SQLite database file (emag.db) and any WAL/SHM journal files
# must NEVER be served by the web server — they are only opened by api.php.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Belt-and-suspenders: also disable PHP execution here, in case
# the rules above are overridden by a parent config.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(db|sqlite|sqlite3|sqlite-journal|sqlite-wal|sqlite-shm|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
